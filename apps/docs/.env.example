# Anthropic API key — required for the /ask AI feature
ANTHROPIC_API_KEY=

# Public site URL — used for canonical links, OG metadata, sitemap, robots, and
# the /api/ask origin check. REQUIRED in production: a Vercel production build
# with this unset fails fast (see lib/site-url.ts) rather than shipping
# localhost URLs.
NEXT_PUBLIC_SITE_URL=https://docs.vinr.com

# --- Ask-AI rate limiting & cost cap (/api/ask) -----------------------------
# Durable rate limiting is backed by Upstash Redis. When these are unset (local
# dev), the route falls back to a weaker in-memory, per-instance limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Per-IP limit (defaults: 10 requests / 60s)
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_MS=60000

# Global daily request ceiling across ALL callers (hard cost cap). Default 5000.
# ASK_DAILY_REQUEST_CAP=5000

# --- Observability (Sentry) -------------------------------------------------
# DSN is safe to expose to the browser. When unset, the Sentry SDK is a no-op,
# so dev/CI stay quiet.
NEXT_PUBLIC_SENTRY_DSN=

# Required only for source-map upload during production builds:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
