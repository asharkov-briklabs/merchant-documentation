{
  "name": "@vinr/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/clean-webpack-cache.mjs && fumadocs-mdx && node scripts/generate-embeddings.mjs",
    "dev": "next dev",
    "prebuild": "fumadocs-mdx && node scripts/generate-embeddings.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib",
    "pretype-check": "fumadocs-mdx",
    "type-check": "tsc --noEmit",
    "check-links": "node scripts/check-internal-links.mjs",
    "generate": "fumadocs-mdx",
    "generate:api": "echo 'generate:api is deprecated — API docs now use openapi.staticSource() directly. See lib/api-source.ts' && exit 1",
    "generate:embeddings": "node scripts/generate-embeddings.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/react": "^3.0.195",
    "@sentry/nextjs": "^10.55.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.193",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "fumadocs-core": "^16.9.3",
    "fumadocs-mdx": "^15.0.10",
    "fumadocs-openapi": "^10.9.1",
    "fumadocs-ui": "^16.9.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
